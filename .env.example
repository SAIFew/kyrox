# Placeholder values only. Never commit real keys or secrets.
# KYROX operates exclusively on Base Sepolia testnet (chainId: 84532).

# Base Sepolia HTTP(S) JSON-RPC endpoint (default: https://sepolia.base.org)
BASE_RPC_URL=https://sepolia.base.org

# Optional HTTP RPC timeout in seconds (0 < timeout <= 120.0, default: 10.0)
# BASE_RPC_TIMEOUT=10.0

# Optional path override to a local JSON stock dataset file (default: data/stocks.json)
# KYROX_STOCKS_FILE=

# Optional transaction safety policy overrides (cannot exceed the 50-token ceiling or canonical tickers)
# KYROX_MAX_TOKEN_AMOUNT=50
# KYROX_MAX_TX_AMOUNT=50
# KYROX_APPROVED_TICKERS=tAAPL,tTSLA,tNVDA
# KYROX_ALLOWED_RECIPIENTS=

# Optional unsigned transaction intent expiration TTL in seconds (1 to 86400, default: 300)
# KYROX_INTENT_TTL_SECONDS=300

# Optional structured JSONL audit logger settings
# KYROX_LOG_DIR=logs
# KYROX_LOG_FILE=audit.jsonl
# KYROX_LOG_MAX_BYTES=5242880
# KYROX_LOG_BACKUP_COUNT=5
