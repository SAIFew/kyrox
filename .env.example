# ===========================================================================
# KYROX Monorepo — TypeScript Application & Services Environment Template
#
# Scope: apps/web, packages/db, services/price, services/trade-intent, and
# deployment verification scripts.
# For the standalone Python MCP server (services/mcp-server), see:
#   services/mcp-server/.env.example
# ===========================================================================

# KYROX consumer app — environment template
#
# Copy to `.env.local` for local development. Never commit real credentials.
# Only variables prefixed with NEXT_PUBLIC_ may reach the browser.
# Everything else must stay server-side.
#
# Chain policy: Base Sepolia only for this product phase. Never point a
# Sepolia build at mainnet, and never copy a mainnet address into Sepolia config.

# ---------------------------------------------------------------------------
# Public preview (simulated venue)
# ---------------------------------------------------------------------------
# 1 = run the consumer app without a database or deployed contracts. Market
# data, balances, and fills are deterministic simulations and are labelled as
# such throughout the UI. Blank = automatic preview when DATABASE_URL is empty.
# 0 explicitly disables preview and requires the complete live configuration;
# never set 0 on the public preview deployment. Only 1/0 (or true/false, yes/no)
# are interpreted; do not use other values, which currently follow auto fallback.
KYROX_DEMO_MODE=

# Optional dedicated HMAC secret for preview sessions. Falls back to AUTH_SECRET.
KYROX_DEMO_SECRET=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Canonical server-side origin of the web app (bare origin, no trailing slash,
# path, query, fragment, or credentials). Required in live Base Sepolia mode and
# must use HTTPS. It defines the SIWE host/URI and the accepted mutation Origin
# headers. A configured HTTPS origin is always validated under production HTTPS
# rules (so the public preview works without KYROX_ENVIRONMENT); plain HTTP is
# limited to loopback local development, and a missing Origin header is accepted
# only for loopback development API clients.
APP_ORIGIN=

# Public origin used by metadata, sitemap, and documentation snippets. During
# migration it is also a fallback for APP_ORIGIN, but set APP_ORIGIN explicitly.
NEXT_PUBLIC_APP_URL=

# Deployment environment label used by guards and telemetry.
NEXT_PUBLIC_CHAIN_ENV=base-sepolia

# Server runtime mode: local-anvil (default) or base-sepolia.
# Local mode requires a loopback RPC and a local-anvil manifest. Live Base
# Sepolia mode requires KYROX_DEMO_MODE=0, PostgreSQL, and a deployed manifest.
KYROX_ENVIRONMENT=local-anvil

# Base Sepolia market-session policy. `unknown` is the fail-closed default:
# quotes and trade intents are refused until an exchange calendar is integrated.
# `always-open-testnet` is an explicit testnet-only opt-in that relies on source
# timestamp freshness, price bounds, and pause state instead of a calendar.
# It is not a mainnet setting and not a claim of 24/7 live prices.
KYROX_MARKET_SESSION_MODE=unknown

# Base Sepolia chain id. Public and non-secret.
NEXT_PUBLIC_CHAIN_ID=84532

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Pooled application connection string used by the web app and services.
DATABASE_URL=

# Direct (non-pooled) connection used by migrations. `pnpm migrate` prefers this
# value and falls back to DATABASE_URL when it is unset or blank.
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------------
# RPC endpoints (server-side only)
# ---------------------------------------------------------------------------
# Base Sepolia JSON-RPC endpoint used for reads and user-operation checks.
BASE_SEPOLIA_RPC_URL=

# Second, independently operated Base Sepolia RPC. Must be archive-capable
# (block zero and the pinned checkpoint must be readable). Required by the
# deployment proposal, verification, and activation flow; identical primary and
# secondary URLs are rejected.
BASE_SEPOLIA_RPC_URL_SECONDARY=

# Base Mainnet JSON-RPC endpoint used read-only by the price service.
# Never used for signing, broadcasting, or trading.
BASE_MAINNET_RPC_URL=

# ---------------------------------------------------------------------------
# Coinbase CDP embedded wallets / smart accounts
# ---------------------------------------------------------------------------
# Public project id used by the CDP client SDK.
NEXT_PUBLIC_CDP_PROJECT_ID=

# Server-side CDP API credentials. Never expose these to the browser.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# ---------------------------------------------------------------------------
# External wallet connection (wagmi)
# ---------------------------------------------------------------------------
# WalletConnect / Reown project id. Public, but restrict allowed origins.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Authentication and admin
# ---------------------------------------------------------------------------
# Secret used to sign session cookies or tokens. Live and preview sessions need
# at least 32 characters; keep it server-side and unique per environment.
AUTH_SECRET=

# Comma-separated admin identity allowlist (emails or subject ids).
ADMIN_ALLOWLIST=

# Bearer secret required by scheduled/administrative endpoints.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Price service
# ---------------------------------------------------------------------------
# Comma-separated tickers the price service is allowed to ingest.
PRICE_ALLOWED_TICKERS=

# Maximum accepted source-price age in seconds before a quote is blocked.
PRICE_MAX_SOURCE_AGE_SECONDS=

# Heartbeat interval for the scheduled ingestion job, in seconds.
PRICE_INGEST_INTERVAL_SECONDS=

# Prepare unsigned setPrice calls. Preparation never signs or broadcasts.
# Blank or false keeps publication disabled; invalid non-boolean values fail
# configuration validation. Explicit true is allowed only after a verified
# deployment and publication procedure are approved.
PRICE_PUBLICATION_ENABLED=false

# Base Sepolia deployment manifest used for publication preparation.
# Defaults to deployments/base-sepolia.json. Preview mode does not read it;
# live mode requires a deployed, approved manifest.
KYROX_DEPLOYMENT_MANIFEST=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Public PostHog key and host. Do not send wallets, emails, or secrets.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry DSN for the browser and server. Use separate projects per environment.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Sentry build-time auth token. Server/CI only.
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Indexer (Base Sepolia Trade/Claim ingestion)
# ---------------------------------------------------------------------------
# Start block only when no checkpoint exists. Otherwise the checkpoint governs.
INDEXER_START_BLOCK=
# Confirmations before a log is treated as canonical.
INDEXER_CONFIRMATIONS=12
INDEXER_CHUNK_SIZE=2000
INDEXER_REORG_DEPTH=12
INDEXER_INTERVAL_MS=15000
# Set to 1 for a single cycle (cron/CI) instead of a polling loop.
INDEXER_ONCE=0

# ---------------------------------------------------------------------------
# Admin bootstrap (CLI only; never expose to the browser)
# ---------------------------------------------------------------------------
# Used once by `pnpm admin:grant`. The first owner then manages roles in /admin.
ADMIN_WALLET=
ADMIN_ROLE=owner

# ---------------------------------------------------------------------------
# Contracts (local tooling only)
# ---------------------------------------------------------------------------
# Explicit public addresses for privileged roles. Dry-run refuses to invent any.
SEPOLIA_ADMIN_ADDRESS=
SEPOLIA_PRICE_UPDATER_ADDRESS=
SEPOLIA_PAUSER_ADDRESS=
SEPOLIA_DEPLOYER_ADDRESS=

# Required per-asset round-to-round deviation guard, e.g.
# tAAPL:500,tNVDA:500,tMSFT:500,tGOOGL:500,tAMZN:500,tTSLA:500,tMETA:500. Values require founder approval.
SEPOLIA_DEVIATION_BPS=

# Required confirmation depth before a publication is marked verified.
VERIFY_CONFIRMATIONS=3

# Required confirmation depth before a deployment can be verified/activated.
DEPLOYMENT_CONFIRMATIONS=12

# Path to a Foundry keystore account used for deployment. Never commit key
# material. Deployment is out of scope for Phase 0.
SEPOLIA_DEPLOYER_ACCOUNT=

# Basescan verification key, if contract verification is approved.
BASESCAN_API_KEY=
