{
  "name": "kyrox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KYROX unified monorepo \u2014 consumer application, marketing site, backend services, Foundry contracts, and Python MCP server (Base Sepolia testnet).",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @kyrox/web build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm build:marketing",
    "test:postgres": "vitest run services/price/test/postgres.integration.test.ts",
    "e2e:anvil": "KYROX_ANVIL_E2E=1 vitest run services/trade-intent/test/e2e.anvil.test.ts",
    "e2e:publication": "bash scripts/publication-e2e.sh",
    "test:postgres:local": "bash scripts/postgres-integration.sh",
    "price:ingest": "tsx services/price/src/cli/main.ts",
    "price:ingest:e2e": "bash scripts/ingest-e2e.sh",
    "price:verify-publication": "tsx services/price/src/cli/verify-main.ts",
    "deploy:sepolia:dry-run": "tsx scripts/deploy-sepolia.ts",
    "verify:sepolia-deployment": "tsx scripts/verify-sepolia-deployment.ts",
    "activate:sepolia-manifest": "tsx scripts/activate-sepolia-manifest.ts",
    "local:bootstrap": "tsx scripts/local-bootstrap.ts",
    "local:e2e": "bash scripts/local-e2e.sh",
    "migrate": "node --input-type=module -e \"import { spawnSync } from 'node:child_process'; const url = process.env.DIRECT_DATABASE_URL?.trim() || process.env.DATABASE_URL?.trim(); if (!url) { console.error('DIRECT_DATABASE_URL or DATABASE_URL is required.'); process.exit(2); } const result = spawnSync('pnpm', ['--filter', '@kyrox/db', 'exec', 'drizzle-kit', 'migrate'], { stdio: 'inherit', env: { ...process.env, DATABASE_URL: url } }); process.exit(result.status ?? 1);\"",
    "build:marketing": "pnpm --filter @kyrox/marketing build",
    "validate:marketing": "node apps/marketing/scripts/validate.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "indexer:run": "tsx services/indexer/src/cli.ts",
    "admin:grant": "tsx scripts/grant-admin.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@kyrox/core": "workspace:*",
    "@kyrox/db": "workspace:*",
    "@kyrox/price": "workspace:*",
    "@kyrox/protocol": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "viem": "2.58.4",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
